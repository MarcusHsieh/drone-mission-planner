# Copy to backend/.env (never commit .env).
ANTHROPIC_API_KEY=
# The agent's model. One value to change. Haiku keeps the demo cheap.
AGENT_MODEL=claude-haiku-5-5
# low | medium | high
AGENT_EFFORT=medium
# Optional: what3words lookups on right-click. The app works without it.
W3W_API_KEY=
# How much faster than real time the simulated drone flies.
SIM_SPEEDUP=5
