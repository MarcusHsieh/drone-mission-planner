# Copy to backend/.env (never commit .env).
ANTHROPIC_API_KEY=
# The agent's model. One value to change. Haiku keeps the demo cheap.
AGENT_MODEL=claude-haiku-5-5
# low | medium | high
AGENT_EFFORT=medium
# Optional: what3words lookups on right-click. The app works without it.
W3W_API_KEY=
# Optional: photorealistic 3D buildings and trees in the 3D view (Google Map
# Tiles API). Restrict the key to the Map Tiles API and to the referrers
# http://localhost:8000/* and http://localhost:5173/*. Without it the 3D view
# shows OSM building boxes instead.
GOOGLE_MAPS_API_KEY=
# How much faster than real time the simulated drone flies.
SIM_SPEEDUP=5
# Which drone Fly uses: sim (built in) or sitl (ArduPilot SITL, see README).
FLIGHT_BACKEND=sim
# SITL's MAVLink port (only used with FLIGHT_BACKEND=sitl).
SITL_CONNECTION=tcp:127.0.0.1:5760
# Task queue energy model (see docs/concepts/task-queue.md). Placeholders for
# a 4S 5000 mAh X500-class quad, not calibrated. Uncomment to change.
# ENERGY_PACK_MAH=5000
# ENERGY_RESERVE_PCT=30
# ENERGY_MARGIN=1.15
# ENERGY_HOVER_A=20
# ENERGY_CRUISE_A=20
# CHARGE_C=1.0
# Simulated charging runs this many times faster than real time.
# CHARGE_SPEEDUP=60
